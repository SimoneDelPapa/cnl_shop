rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /utenti/{userId} {
      // 1. Consente la query di verifica email prima del login (Password dimenticata)
      allow list: if request.auth != null || 
        (resource.data.email != null && request.query.limit <= 1);

      // 2. Lettura del singolo documento e scrittura riservate agli utenti autenticati
      allow get: if request.auth != null;
      allow write: if request.auth != null;
      
      // Sotto-collezione notifiche
      match /notifiche/{notifId} {
        allow read, write: if request.auth != null;
      }
    }

    // Prodotti leggibili da chiunque (anche nel carosello di login), modificabili da autenticati
    match /prodotti/{prodottoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ordini gestibili da utenti autenticati
    match /ordini/{ordineId} {
      allow read, write: if request.auth != null;
    }
  }
}